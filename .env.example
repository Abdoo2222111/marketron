# ─────────────────────────────────────────────
# منصة التسويق الإلكتروني
# Marketing Platform - Environment Variables
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NODE_ENV=development
APP_NAME=منصة التسويق الإلكتروني
API_PREFIX=/api/v1

# ── Server Ports ─────────────────────────────
API_PORT=3001
AI_PORT=3002
INTEGRATIONS_PORT=3003
DASHBOARD_PORT=5173

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://marketing:marketing_secret_2026@localhost:5432/marketing_platform
DB_HOST=localhost
DB_PORT=5432
DB_USER=marketing
DB_PASSWORD=marketing_secret_2026
DB_NAME=marketing_platform

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT Authentication ───────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend ─────────────────────────────────
FRONTEND_URL=http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── AI Providers ─────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# ── Social Platform OAuth ────────────────────
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
TIKTOK_APP_ID=your-tiktok-app-id
TIKTOK_APP_SECRET=your-tiktok-app-secret
SNAPCHAT_APP_ID=your-snapchat-app-id
SNAPCHAT_APP_SECRET=your-snapchat-app-secret

# ── WhatsApp ─────────────────────────────────
WHATSAPP_API_KEY=your-whatsapp-business-api-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ── Email (Resend) ───────────────────────────
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@marketing-platform.com

# ── Storage ──────────────────────────────────
STORAGE_PROVIDER=local # local, supabase, cloudinary
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Monitoring ───────────────────────────────
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ENVIRONMENT=development
UPTIMEROBOT_API_KEY=your-uptimerobot-api-key

# ── Payment (Stripe) ─────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# ── Rate Limiting ────────────────────────────
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
