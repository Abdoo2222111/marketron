# ─────────────────────────────────────────────
# MARKETRON AI Suite — Environment Variables
# ─────────────────────────────────────────────
# انسخ هذا الملف إلى .env.local وعدّل القيم

# ── App ──────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=MARKETRON
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:4000

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketron

# ── JWT Authentication ───────────────────────
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=marketron

# ── AI Providers (اختياري — يكفي مزود واحد) ───
AI_DEFAULT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
GEMINI_API_KEY=your-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Groq (مجاني)
GROQ_API_KEY=gsk_your-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# DeepSeek
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Mistral
MISTRAL_API_KEY=your-key
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── WhatsApp / Evolution API ─────────────────
WHATSAPP_EVOLUTION_API_URL=https://evolution-api-production.up.railway.app
WHATSAPP_EVOLUTION_API_KEY=eko_your-api-key
WHATSAPP_DEFAULT_INSTANCE=marketron

# ── Meta (Facebook/Instagram) ────────────────
FACEBOOK_APP_ID=your-fb-app-id
FACEBOOK_APP_SECRET=your-fb-app-secret
FACEBOOK_GRAPH_VERSION=v19.0
FACEBOOK_WEBHOOK_VERIFY_TOKEN=marketron-webhook-token

# ── TikTok ───────────────────────────────────
TIKTOK_APP_ID=your-tiktok-app-id
TIKTOK_APP_SECRET=your-tiktok-app-secret

# ── Snapchat ─────────────────────────────────
SNAPCHAT_APP_ID=your-snapchat-app-id
SNAPCHAT_APP_SECRET=your-snapchat-app-secret

# ── Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token

# ── Twitter / X ──────────────────────────────
TWITTER_API_KEY=your-key
TWITTER_API_SECRET=your-secret
TWITTER_BEARER_TOKEN=your-bearer-token

# ── Google OAuth ─────────────────────────────
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Email (SMTP) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@marketron.ai

# ── Storage ──────────────────────────────────
STORAGE_PROVIDER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ── Payment (Stripe) ─────────────────────────
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# ── Credits ──────────────────────────────────
FREE_TIER_CREDITS=100
AI_CREDIT_COST=1
CREDIT_REFILL_PRICE=10

# ── Rate Limiting ────────────────────────────
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=3
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# ── Security ─────────────────────────────────
CSRF_TOKEN_SECRET=your-csrf-secret
COOKIE_SECRET=your-cookie-secret
BCRYPT_SALT_ROUNDS=12
