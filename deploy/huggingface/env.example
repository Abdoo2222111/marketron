# ============================================================
# MARKETRON AI Suite — Hugging Face Environment Variables
# ============================================================
# انسخ هذا الملف إلى .env وأضف القيم الصحيحة
# ============================================================

# ── Server ────────────────────────────────────────────
PORT=4000
NODE_ENV=production
API_PREFIX=/api

# ── Database (Supabase PostgreSQL) ────────────────────
DATABASE_URL=postgresql://user:password@host:5432/marketron

# ── Redis (Upstash) ───────────────────────────────────
REDIS_URL=redis://default:password@host:6379

# ── JWT ──────────────────────────────────────────────
JWT_ACCESS_SECRET=<your-64-char-random-secret>
JWT_REFRESH_SECRET=<your-another-64-char-random-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app

# ── AI Providers ─────────────────────────────────────
# على الأقل مزود واحد مطلوب
AI_DEFAULT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key

# DeepSeek (رخيص)
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_MODEL=deepseek-chat

# Gemini (مجاني)
GEMINI_API_KEY=your-gemini-key

# Groq (مجاني)
GROQ_API_KEY=your-groq-key

# ── WhatsApp / Evolution API ─────────────────────────
WHATSAPP_EVOLUTION_API_URL=https://your-evolution-space.hf.space
WHATSAPP_EVOLUTION_API_KEY=your-api-key
WHATSAPP_DEFAULT_INSTANCE=marketron

# ── Social Media Platforms ──────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=marketron-webhook-verify

INSTAGRAM_BUSINESS_ACCOUNT_ID=

TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

SNAPCHAT_APP_ID=
SNAPCHAT_APP_SECRET=

# ── Encryption ──────────────────────────────────────
ENCRYPTION_MASTER_KEY=<32-char-random-key>
TOKEN_ENCRYPTION_KEY=<32-char-random-key-for-oauth>
