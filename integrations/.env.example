# ============================================
# Social Media Integrations - Environment Config
# ============================================
# Copy this file to .env and fill in your credentials

# Server
PORT=4000
NODE_ENV=development

# ============================================
# Facebook / Instagram Graph API
# ============================================
# 1. Go to https://developers.facebook.com/
# 2. Create an App > Business
# 3. Add "Marketing API" product
# 4. Get App ID and App Secret from App Dashboard > Basic Settings
FACEBOOK_APP_ID=123456789
FACEBOOK_APP_SECRET=abc123def456...
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/platforms/callback/facebook

# ============================================
# TikTok Business API
# ============================================
# 1. Go to https://ads.tiktok.com/marketing_api/
# 2. Create an App
# 3. Get App ID and App Secret from App Details
TIKTOK_APP_ID=123456789
TIKTOK_APP_SECRET=abc123def456...
TIKTOK_REDIRECT_URI=http://localhost:4000/api/v1/platforms/callback/tiktok

# ============================================
# Snapchat Marketing API
# ============================================
# 1. Go to https://developers.snapchat.com/
# 2. Create an App
# 3. Get Client ID and Client Secret from App Settings
SNAPCHAT_CLIENT_ID=123456789
SNAPCHAT_CLIENT_SECRET=abc123def456...
SNAPCHAT_REDIRECT_URI=http://localhost:4000/api/v1/platforms/callback/snapchat
SNAPCHAT_ORGANIZATION_ID=your_org_id_here

# ============================================
# Google APIs (Optional)
# ============================================
# 1. Go to https://console.cloud.google.com/
# 2. Create a project
# 3. Enable APIs: Analytics, Ads, Search Console, YouTube
# 4. Create OAuth 2.0 credentials
GOOGLE_CLIENT_ID=123456789.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=abc123def456...
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/platforms/callback/google
GOOGLE_REFRESH_TOKEN=

# ============================================
# Encryption (for token storage)
# ============================================
TOKEN_ENCRYPTION_KEY=your-secret-encryption-key-at-least-32-chars-long
