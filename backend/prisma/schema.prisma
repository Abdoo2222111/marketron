// MARKETRON Prisma Schema — PostgreSQL
// Run: npx prisma db push   (dev)
// Run: npx prisma migrate deploy (prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

// ========================
// 0. ORGANIZATIONS
// ========================

model Organization {
  id        String   @id @default(uuid())
  name      String
  domainSlug String? @unique @map("domain_slug")
  mode      String   @default("client")
  // Workspace fields added for service compatibility (workspace.service.ts)
  companySize       String?  @map("company_size")
  industry          String?
  country           String?
  city              String?
  vatNumber         String?  @map("vat_number")
  status            String   @default("trial")
  subscriptionTier  String?  @default("starter") @map("subscription_tier")
  subscriptionEndsAt DateTime? @map("subscription_ends_at")
  storageUsed       BigInt?  @default(0) @map("storage_used")
  storageLimit      BigInt?  @default(0) @map("storage_limit")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  businessProfile   BusinessProfile?
  personaConfig     PersonaConfig?
  campaigns         Campaign[]
  conversations     Conversation[]
  platformConnections PlatformConnection[]
  contents          Content[]
  aiProviderConfigs AiProviderConfig[]

  @@map("organizations")
}

model BusinessProfile {
  id          String   @id @default(uuid())
  orgId       String   @unique @map("org_id")
  companyName String?  @map("company_name")
  industry    String?
  website     String?
  description String?
  logoUrl     String?  @map("logo_url")
  phone       String?
  address     String?
  targetAudience String? @map("target_audience")
  products    String?
  productsServices String? @map("products_services")
  faqs        String?
  pricingTier String?  @map("pricing_tier")
  toneOfVoice String?  @map("tone_of_voice")
  faqData       String?  @map("faq_data")
  enrichedByAi  Boolean  @default(false) @map("enriched_by_ai")
  sourceUrl     String?  @map("source_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model PersonaConfig {
  id            String   @id @default(uuid())
  orgId         String   @unique @map("org_id")
  agentName     String?  @map("agent_name")
  agentRole     String?  @map("agent_role")
  welcomeMessage String? @map("welcome_message")
  personality   String?
  maxContextLength Int   @default(20) @map("max_context_length")
  fallbackResponse String? @map("fallback_response")
  companyInfo   String?  @map("company_info")
  customPrompt  String?  @map("custom_prompt")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("persona_configs")
}

// ========================
// 1. USERS & AUTH
// ========================

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?  @map("password_hash")
  password       String?
  name           String
  provider       String   @default("local")
  providerId     String?  @map("provider_id")
  role           String   @default("member")
  phone          String?
  company        String?
  avatarUrl      String?  @map("avatar_url")
  isActive       Boolean  @default(true) @map("is_active")
  isVerified     Boolean  @default(false) @map("is_verified")
  verificationToken String? @map("verification_token")
  credits        Int      @default(100)
  organizationId String?  @map("org_id")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  campaigns      Campaign[]
  platformConnections PlatformConnection[]
  notifications  Notification[]
  socialInboxes  SocialInbox[]
  aiProviderConfigs AiProviderConfig[]
  teamMemberships TeamMember[]
  ownedTeams      Team[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ========================
// 2. CAMPAIGNS
// ========================

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  platform    String
  status      String   @default("draft_pending_approval")
  objective   String   @default("awareness")
  budgetType  String?  @default("daily") @map("budget_type")
  budgetAmount Float?  @map("budget_amount")
  budgetCurrency String? @default("USD") @map("budget_currency")
  spend       Float    @default(0)
  revenue     Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  cpm         Float    @default(0)
  cpa         Float    @default(0)
  roas        Float    @default(0)
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  targetUrl   String?  @map("target_url")
  targetAudience String? @map("target_audience")
  targetCountry String? @map("target_country")
  targetAgeMin Int?     @map("target_age_min")
  targetAgeMax Int?     @map("target_age_max")
  targetGender String?  @map("target_gender")
  targetInterests String? @map("target_interests")
  creativeIds  String?  @map("creative_ids")
  creativeText String?  @map("creative_text")
  creativeHeadline String? @map("creative_headline")
  creativeCta  String?  @map("creative_cta")
  creativeImageUrl String? @map("creative_image_url")
  creativeVideoUrl String? @map("creative_video_url")
  settings     String?
  aiGenerated  Boolean  @default(false) @map("ai_generated")
  approvedBy   String?  @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  platformCampaignId String? @map("platform_campaign_id")
  lastSyncedAt DateTime? @map("last_synced_at")
  organizationId String? @map("org_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User       @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ads          Ad[]
  adSnapshots  AdSnapshot[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([platform])
  @@map("campaigns")
}

model Ad {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  platform    String
  name        String
  status      String   @default("draft")
  creativeText String?  @map("creative_text")
  creativeHeadline String? @map("creative_headline")
  creativeCta String?  @map("creative_cta")
  creativeImageUrl String? @map("creative_image_url")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  spend       Float    @default(0)
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  cpm         Float    @default(0)
  cpa         Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("ads")
}

model AdSnapshot {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  platform    String
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  spend       Float    @default(0)
  revenue     Float    @default(0)
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  cpm         Float    @default(0)
  cpa         Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, date])
  @@map("ad_snapshots")
}

// ========================
// 3. SOCIAL / INBOX
// ========================

model SocialInbox {
  id                String   @id @default(uuid())
  name              String?
  platform          String
  platformAccountId String   @map("platform_account_id")
  platformAccountName String? @map("platform_account_name")
  status            String   @default("active")
  isConnected       Boolean  @default(false) @map("is_connected")
  webhookToken      String?  @unique @map("webhook_token")
  phoneNumber       String?  @map("phone_number")
  settings          String?
  qrCodeUrl         String?  @map("qr_code_url")
  lastSyncAt        DateTime? @map("last_sync_at")
  lastSyncedAt      DateTime? @map("last_synced_at")
  userId            String   @map("user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User         @relation(fields: [userId], references: [id])
  messages          SocialMessage[]
  whatsAppSessions  WhatsAppSession[]

  @@index([userId])
  @@index([platform])
  @@map("social_inboxes")
}

model SocialMessage {
  id              String   @id @default(uuid())
  inboxId         String   @map("inbox_id")
  direction       String
  status          String   @default("unread")
  senderName      String   @map("sender_name")
  senderId        String   @map("sender_id")
  phoneNumber     String?  @map("phone_number")
  messageText     String   @map("message_text")
  mediaUrl        String?  @map("media_url")
  aiReply         String?  @map("ai_reply")
  aiUsed          Boolean  @default(false) @map("ai_used")
  sentAt          DateTime @default(now()) @map("sent_at")
  createdAt       DateTime @default(now()) @map("created_at")

  // Fields added for service compatibility (socialInbox.service.ts)
  userId            String   @map("user_id")
  platform          String
  platformMessageId String?  @map("platform_message_id")
  metadata          String?
  readAt            DateTime? @map("read_at")
  repliedAt         DateTime? @map("replied_at")
  replyFromAi       Boolean  @default(false) @map("reply_from_ai")
  aiReplyText       String?  @map("ai_reply_text")
  aiAgentId         String?  @map("ai_agent_id")

  inbox SocialInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([inboxId])
  @@index([sentAt])
  @@index([userId])
  @@index([platformMessageId])
  @@map("social_messages")
}

model WhatsAppSession {
  id         String   @id @default(uuid())
  inboxId    String   @unique @map("inbox_id")
  instance   String
  status     String   @default("pending")
  qrCode     String?  @map("qr_code")
  phoneNumber String? @map("phone_number")
  // Fields added for service compatibility (socialInbox.service.ts)
  userId            String?  @map("user_id")
  qrCodeExpiresAt   DateTime? @map("qr_code_expires_at")
  lastConnectedAt   DateTime? @map("last_connected_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  inbox SocialInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("whatsapp_sessions")
}

model PlatformConnection {
  id                 String   @id @default(uuid())
  platform           String
  platformAccountId  String?  @map("platform_account_id")
  platformAccountName String? @map("platform_account_name")
  accessToken        String?  @map("access_token")
  refreshToken       String?  @map("refresh_token")
  tokenExpiresAt     DateTime? @map("token_expires_at")
  webhookSecret      String?  @map("webhook_secret")
  settings           String?
  status             String   @default("active")
  lastSyncAt         DateTime? @map("last_sync_at")
  metadata           String?
  organizationId     String?  @map("org_id")
  userId             String   @map("user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user               User           @relation(fields: [userId], references: [id])
  organization       Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([platform, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("platform_connections")
}

// ========================
// 4. CONTENT STUDIO
// ========================

model Content {
  id          String   @id @default(uuid())
  type        String
  title       String?
  body        String?
  description String?
  fileUrl     String?  @map("file_url")
  fileSize    Int?     @map("file_size")
  platform    String?
  status      String   @default("draft")
  mediaUrl    String?  @map("media_url")
  thumbnailUrl String? @map("thumbnail_url")
  metadata    String?
  tags        String?
  aiGenerated Boolean  @default(false) @map("ai_generated")
  organizationId String? @map("org_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([type])
  @@map("contents")
}

// ========================
// 5. ANALYTICS & COMPETITORS
// ========================

model AnalyticsSnapshot {
  id              String @id @default(uuid())
  date            DateTime @map("date")
  totalCampaigns  Int    @default(0) @map("total_campaigns")
  activeCampaigns Int    @default(0) @map("active_campaigns")
  totalSpend      Float  @default(0) @map("total_spend")
  totalImpressions Int   @default(0) @map("total_impressions")
  totalClicks     Int    @default(0) @map("total_clicks")
  totalConversions Int   @default(0) @map("total_conversions")
  avgCtr          Float  @default(0) @map("avg_ctr")
  avgCpc          Float  @default(0) @map("avg_cpc")
  platformBreakdown String? @map("platform_breakdown")
  userId          String @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@map("analytics_snapshots")
}

model AnalyticsReport {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  type      String
  filters   String?
  chartData String?  @map("chart_data")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("analytics_reports")
}

model Competitor {
  id              String   @id @default(uuid())
  name            String
  platform        String?
  platformUsername String?  @map("platform_username")
  website         String?
  description     String?
  notes           String?
  estimatedSpend  Float?   @default(0) @map("estimated_spend")
  activeAdsCount  Int?     @default(0) @map("active_ads_count")
  metrics         String?
  alerts          String?
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  competitorAds   CompetitorAd[]

  @@index([userId])
  @@map("competitors")
}

model CompetitorAd {
  id            String   @id @default(uuid())
  competitorId  String   @map("competitor_id")
  snapshotDate  DateTime @map("snapshot_date")
  headline      String?
  body          String?
  cta           String?
  mediaUrl      String?  @map("media_url")
  platform      String?
  status        String?  @default("active")
  metadata      String?
  createdAt     DateTime @default(now()) @map("created_at")

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, snapshotDate])
  @@map("competitor_ads")
}

model MarketReport {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  productName     String?  @map("product_name")
  productCategory String?  @map("product_category")
  country         String?
  reportData      String?  @map("report_data")
  reportSummary   String?  @map("report_summary")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("market_reports")
}

// ========================
// 6. AI & NOTIFICATIONS
// ========================

model ApiKeyVault {
  id              String   @id @default(uuid())
  provider        String
  keyEncrypted    String   @map("key_encrypted")
  baseUrl         String?  @map("base_url")
  defaultModel    String?  @map("default_model")
  label           String?
  isDefaultForType String? @map("is_default_for_type")
  status          String   @default("active")
  lastUsedAt      DateTime? @map("last_used_at")
  userId          String   @map("user_id")
  orgId           String?  @map("org_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([orgId])
  @@index([provider, userId])
  @@map("api_key_vault")
}

model PersonaOverride {
  id           String   @id @default(uuid())
  section      String
  customPrompt String?  @map("custom_prompt")
  temperature  Float?
  userId       String   @map("user_id")
  orgId        String?  @map("org_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([section, userId])
  @@index([userId])
  @@index([orgId])
  @@map("persona_overrides")
}

model AiProviderConfig {
  id           String   @id @default(uuid())
  provider     String
  apiKey       String?  @map("api_key")
  baseUrl      String?  @map("base_url")
  defaultModel String?  @map("default_model")
  isActive     Boolean  @default(true) @map("is_active")
  organizationId String? @map("org_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])

  @@unique([provider, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("ai_provider_configs")
}

model AiRequest {
  id          String   @id @default(uuid())
  type        String
  prompt      String?
  response    String?
  model       String   @default("deepseek")
  provider    String   @default("deepseek")
  tokensUsed  Int      @default(0) @map("tokens_used")
  duration    Int      @default(0)
  status      String   @default("success")
  errorMsg    String?  @map("error_msg")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("ai_requests")
}

model AiAgent {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("general_agent")
  description String?
  systemPrompt String? @map("system_prompt")
  temperature Float    @default(0.7)
  maxTokens   Int      @default(2000) @map("max_tokens")
  model       String   @default("deepseek")
  provider    String   @default("deepseek")
  tools       String?  @default("[\"chat\",\"search\"]")
  isActive    Boolean  @default(true) @map("is_active")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  replyRules   AiReplyRule[]
  agentMessages AiAgentMessage[]

  @@index([userId])
  @@map("ai_agents")
}

model AiAgentMessage {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  userId    String   @map("user_id")
  role      String
  content   String
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([userId])
  @@map("ai_agent_messages")
}

model AiGeneration {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  prompt      String?
  model       String?
  provider    String?
  resultUrl   String?  @map("result_url")
  resultText  String?  @map("result_text")
  tokensUsed  Int?     @default(0) @map("tokens_used")
  cost        Float?   @default(0)
  status      String   @default("success")
  metadata    String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("ai_generations")
}

model AiReplyRule {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  isActive        Boolean  @default(true) @map("is_active")
  platform        String?
  priority        Int      @default(0)
  responseTemplate String? @map("response_template")
  useAi           Boolean  @default(false) @map("use_ai")
  triggerType     String?  @map("trigger_type")
  triggerValue    String?  @map("trigger_value")
  aiPrompt        String?  @map("ai_prompt")
  agentId         String?  @map("agent_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  agent AiAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("ai_reply_rules")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String?
  type      String   @default("info")
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ========================
// 7. CONVERSATIONS
// ========================

model PlatformToken {
  id             String    @id @default(uuid())
  platform       String
  label          String?
  accessToken    String    @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  status         String    @default("active")
  metadata       String?
  userId         String    @map("user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([platform, userId])
  @@index([userId])
  @@map("platform_tokens")
}

model Conversation {
  id        String   @id @default(uuid())
  orgId     String?  @map("org_id")
  platform  String
  contactId String   @map("contact_id")
  contactName String  @map("contact_name")
  contactPhone String? @map("contact_phone")
  status    String   @default("open")
  unread    Int      @default(0)
  lastMessageAt DateTime @map("last_message_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org      Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([orgId, status])
  @@index([platform])
  @@map("conversations")
}

model Message {
  id          String   @id @default(uuid())
  conversationId String @map("conversation_id")
  direction   String
  text        String
  sender      String
  status      String   @default("sent")
  mediaUrl    String?  @map("media_url")
  metadata    String?
  // Fields added for service compatibility (conversation.service.ts)
  senderType        String?  @map("sender_type")
  aiConfidenceScore Float?   @map("ai_confidence_score")
  aiModeUsed        String?  @map("ai_mode_used")
  aiModelUsed       String?  @map("ai_model_used")
  createdAt   DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ========================
// 8. BILLING & CREDITS
// ========================

model Invoice {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Float
  currency  String   @default("USD")
  status    String   @default("pending")
  items     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("invoices")
}

model UserCredits {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  balance        Float    @default(0)
  totalSpent     Float    @default(0) @map("total_spent")
  totalPurchased Float    @default(0) @map("total_purchased")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("user_credits")
}

model Subscription {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  plan              String
  status            String   @default("active")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd  DateTime @map("current_period_end")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Float
  currency  String   @default("USD")
  status    String   @default("pending")
  method    String?
  reference String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("payments")
}

model CreditTransaction {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  amount      Float
  type        String
  description String?
  balanceAfter Float  @map("balance_after")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("credit_transactions")
}

model ClientProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String?  @map("company_name")
  companySize String?  @map("company_size")
  industry    String?
  country     String?
  city        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("client_profiles")
}

model ApiKeyRecord {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  keyHash   String   @map("key_hash")
  prefix    String
  scopes    String?
  isActive  Boolean  @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("api_key_records")
}

// ========================
// 10. AUDIT LOG
// ========================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String?
  resourceId String?  @map("resource_id")
  details    String?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ========================
// 9. TEAM
// ========================

model Team {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members TeamMember[]
  owner   User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("team_members")
}
