// MARKETRON Prisma Schema — PostgreSQL for production, SQLite for dev
// Run: DATABASE_URL="file:./dev.db" npx prisma db push   (dev)
// Run: npx prisma migrate deploy                        (prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ========================
// 0. ORGANIZATIONS & PERSONA (V2 Multi-Tenant Core)
// ========================

model Organization {
  id        String   @id @default(uuid())
  name      String
  domainSlug String? @unique @map("domain_slug")
  mode      String   @default("client") // acquire_for_marketron | client
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  businessProfile   BusinessProfile?
  personaConfig     PersonaConfig?
  campaigns         Campaign[]
  conversations     Conversation[]
  platformConnections PlatformConnection[]
  contents          Content[]

  @@map("organizations")
}

model BusinessProfile {
  id          String   @id @default(uuid())
  orgId       String   @unique @map("org_id")
  companyName String?  @map("company_name")
  industry    String?
  website     String?
  description String?
  logoUrl     String?  @map("logo_url")
  phone       String?
  address     String?
  targetAudience String? @map("target_audience")
  products    String?  // JSON array of products/services
  pricingTier String?  @map("pricing_tier")
  toneOfVoice String?  @map("tone_of_voice")
  faqData     String?  @map("faq_data") // JSON
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model PersonaConfig {
  id            String   @id @default(uuid())
  orgId         String   @unique @map("org_id")
  agentName     String?  @map("agent_name")
  agentRole     String?  @map("agent_role")
  welcomeMessage String? @map("welcome_message")
  personality   String?  // JSON: traits, style, etc.
  maxContextLength Int   @default(20) @map("max_context_length")
  fallbackResponse String? @map("fallback_response")
  companyInfo   String?  @map("company_info")
  customPrompt  String?  @map("custom_prompt")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("persona_configs")
}

// ========================
// 1. USERS & AUTH
// ========================

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String?
  name           String
  provider       String   @default("local")
  providerId     String?  @map("provider_id")
  role           String   @default("member") // admin | member
  phone          String?
  company        String?
  avatarUrl      String?  @map("avatar_url")
  isActive       Boolean  @default(true) @map("is_active")
  isVerified     Boolean  @default(false) @map("is_verified")
  verificationToken String? @map("verification_token")
  credits        Int      @default(100)
  organizationId String?  @map("org_id")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  campaigns      Campaign[]
  platformConnections PlatformConnection[]
  notifications  Notification[]
  socialInboxes  SocialInbox[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ========================
// 2. CAMPAIGNS
// ========================

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  platform    String   // facebook | instagram | tiktok | snapchat | whatsapp | messenger | twitter | telegram
  status      String   @default("draft_pending_approval") // draft_pending_approval | approved | published | active | paused | completed
  objective   String   @default("awareness")
  budget      Float    @default(0)
  spent       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  ctr         Float    @default(0)
  cpc         Float    @default(0)
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  targetUrl   String?  @map("target_url")
  targetAudience String? @map("target_audience")
  creativeIds  String?  @map("creative_ids") // JSON array
  settings     String?  // JSON
  aiGenerated  Boolean  @default(false) @map("ai_generated")
  approvedBy   String?  @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  organizationId String? @map("org_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User       @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([platform])
  @@map("campaigns")
}

// ========================
// 3. SOCIAL / INBOX
// ========================

model SocialInbox {
  id                String   @id @default(uuid())
  platform          String   // facebook | instagram | whatsapp | telegram | messenger | twitter
  platformAccountId String   @map("platform_account_id")
  platformAccountName String? @map("platform_account_name")
  status            String   @default("active")
  isConnected       Boolean  @default(false) @map("is_connected")
  webhookToken      String?  @unique @map("webhook_token")
  lastSyncAt        DateTime? @map("last_sync_at")
  userId            String   @map("user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User         @relation(fields: [userId], references: [id])
  messages          SocialMessage[]
  whatsAppSessions  WhatsAppSession[]

  @@index([userId])
  @@index([platform])
  @@map("social_inboxes")
}

model SocialMessage {
  id          String   @id @default(uuid())
  inboxId     String   @map("inbox_id")
  direction   String   // inbound | outbound
  status      String   @default("unread") // unread | read | replied
  senderName  String   @map("sender_name")
  senderId    String   @map("sender_id")
  phoneNumber String?  @map("phone_number")
  messageText String   @map("message_text")
  mediaUrl    String?  @map("media_url")
  aiReply     String?  @map("ai_reply")
  aiUsed      Boolean  @default(false) @map("ai_used")
  sentAt      DateTime @default(now()) @map("sent_at")
  createdAt   DateTime @default(now()) @map("created_at")

  inbox SocialInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([inboxId])
  @@index([sentAt])
  @@map("social_messages")
}

model WhatsAppSession {
  id         String   @id @default(uuid())
  inboxId    String   @map("inbox_id")
  instance   String
  status     String   @default("pending")
  qrCode     String?  @map("qr_code")
  phoneNumber String? @map("phone_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  inbox SocialInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

model PlatformConnection {
  id                 String   @id @default(uuid())
  platform           String   @unique
  platformAccountId  String?  @map("platform_account_id")
  platformAccountName String? @map("platform_account_name")
  accessToken        String?  @map("access_token")
  refreshToken       String?  @map("refresh_token")
  tokenExpiresAt     DateTime? @map("token_expires_at")
  webhookSecret      String?  @map("webhook_secret")
  settings           String?  // JSON
  status             String   @default("active")
  lastSyncAt         DateTime? @map("last_sync_at")
  metadata           String?  // JSON
  organizationId     String?  @map("org_id")
  userId             String   @map("user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user               User           @relation(fields: [userId], references: [id])
  organization       Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@map("platform_connections")
}

// ========================
// 4. CONTENT STUDIO
// ========================

model Content {
  id          String   @id @default(uuid())
  type        String   // text | image | video | carousel | story
  title       String?
  body        String?
  platform    String?
  status      String   @default("draft") // draft | published | archived
  mediaUrl    String?  @map("media_url")
  thumbnailUrl String? @map("thumbnail_url")
  metadata    String?  // JSON
  tags        String?  // JSON array
  aiGenerated Boolean  @default(false) @map("ai_generated")
  organizationId String? @map("org_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([type])
  @@map("contents")
}

// ========================
// 5. ANALYTICS & COMPETITORS
// ========================

model AnalyticsSnapshot {
  id              String @id @default(uuid())
  date            DateTime @map("date")
  totalCampaigns  Int    @default(0) @map("total_campaigns")
  activeCampaigns Int    @default(0) @map("active_campaigns")
  totalSpend      Float  @default(0) @map("total_spend")
  totalImpressions Int   @default(0) @map("total_impressions")
  totalClicks     Int    @default(0) @map("total_clicks")
  totalConversions Int   @default(0) @map("total_conversions")
  avgCtr          Float  @default(0) @map("avg_ctr")
  avgCpc          Float  @default(0) @map("avg_cpc")
  platformBreakdown String? @map("platform_breakdown") // JSON
  userId          String @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@map("analytics_snapshots")
}

model Competitor {
  id          String   @id @default(uuid())
  name        String
  platform    String?
  website     String?
  description String?
  metrics     String?  // JSON
  alerts      String?  // JSON
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("competitors")
}

// ========================
// 6. AI & NOTIFICATIONS
// ========================

model AiRequest {
  id          String   @id @default(uuid())
  type        String   // generate | analyze | recommend | enhance
  prompt      String?
  response    String?
  model       String   @default("deepseek")
  provider    String   @default("deepseek")
  tokensUsed  Int      @default(0) @map("tokens_used")
  duration    Int      @default(0)
  status      String   @default("success") // success | error | pending
  errorMsg    String?  @map("error_msg")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("ai_requests")
}

model AiAgent {
  id          String   @id @default(uuid())
  name        String
  description String?
  systemPrompt String? @map("system_prompt")
  temperature Float    @default(0.7)
  maxTokens   Int      @default(2000) @map("max_tokens")
  model       String   @default("deepseek")
  provider    String   @default("deepseek")
  isActive    Boolean  @default(true) @map("is_active")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("ai_agents")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String?
  type      String   @default("info") // info | success | warning | error
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ========================
// 7. CONVERSATIONS (V2 Unified Inbox)
// ========================

model Conversation {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  platform  String   // whatsapp | facebook | instagram | telegram | messenger | twitter
  contactId String   @map("contact_id")
  contactName String  @map("contact_name")
  contactPhone String? @map("contact_phone")
  status    String   @default("open") // open | resolved | archived
  unread    Int      @default(0)
  lastMessageAt DateTime @map("last_message_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([orgId, status])
  @@index([platform])
  @@map("conversations")
}

model Message {
  id          String   @id @default(uuid())
  conversationId String @map("conversation_id")
  direction   String   // inbound | outbound
  text        String
  sender      String   // customer | agent | bot
  status      String   @default("sent") // sent | delivered | read | failed
  mediaUrl    String?  @map("media_url")
  metadata    String?  // JSON
  createdAt   DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}
