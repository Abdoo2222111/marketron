# MARKETRON Backend — Environment Variables
# Copy to .env and fill in values

# Server
NODE_ENV=production
PORT=4000

# Database (PostgreSQL — get free DB from Supabase or Neon)
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://user:password@host:5432/marketron

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=your-access-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=https://marketron.vercel.app
CORS_ORIGIN=https://marketron.vercel.app

# AI Provider (OpenAI-compatible — DeepSeek by default)
OPENAI_API_KEY=your-openai-or-deepseek-api-key
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
