# ============
# Server
# ============
NODE_ENV=production
PORT=4000

# ============
# Database (PostgreSQL - Neon)
# ============
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/marketron?sslmode=require

# ============
# JWT
# ============
JWT_ACCESS_SECRET=generate-a-random-secret-here
JWT_REFRESH_SECRET=generate-another-random-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============
# CORS - Frontend URL
# ============
FRONTEND_URL=https://marketron.vercel.app
CORS_ORIGIN=https://marketron.vercel.app

# ============
# Email (SMTP)
# ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=marketron@yourdomain.com

# ============
# OpenAI (AI features)
# ============
OPENAI_API_KEY=sk-your-openai-key

# ============
# Optional: Meta/Facebook
# ============
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ============
# Optional: Google OAuth
# ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://marketron-backend.onrender.com/api/v1/auth/google/callback

# ============
# Optional: Stripe
# ============
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
