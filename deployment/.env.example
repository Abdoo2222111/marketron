# ============================================================
# نموذج متغيرات البيئة - منصة التسويق الإلكتروني
# All Environment Variables (.env.example)
# ============================================================

# ── General ──────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api

# ── Database (PostgreSQL - Supabase / Neon / Render) ─────────
DATABASE_URL=postgresql://user:password@host:5432/marketing_platform

# ── JWT Authentication ──────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-random-64-char-string
JWT_REFRESH_SECRET=replace-with-random-64-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis (Optional - for Bull queues & caching) ─────────────
REDIS_URL=redis://host:6379
REDIS_ENABLED=false
CACHE_TTL=3600

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=https://marketing-platform.vercel.app

# ── Upload ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ── Bcrypt ───────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ── Swagger / OpenAPI ────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_TITLE=منصة التسويق الإلكتروني - API
SWAGGER_VERSION=1.0.0

# ── Sentry (Monitoring) ─────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/123
SENTRY_ENVIRONMENT=production

# ── Email (Resend / SMTP) ───────────────────────────────────
RESEND_API_KEY=re_xxx...
EMAIL_FROM=noreply@marketing-platform.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── Supabase (Optional - for Storage) ────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx...
SUPABASE_SERVICE_ROLE_KEY=xxx...

# ── Cloudinary (Optional - alternative Storage) ──────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abc123def456

# ── AI Services (FastAPI) ────────────────────────────────────
AI_SERVICES_URL=https://marketing-ai-services.up.railway.app

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_GENERATION_MODEL=gpt-4o

# ── Anthropic (Optional) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx...
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# ── HuggingFace (Optional - for local models) ────────────────
HF_TOKEN=
USE_LOCAL_MODELS=false

# ── OpenTelemetry (Optional) ─────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=marketing-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Frontend Vite (in frontend/.env.production) ──────────────
VITE_API_URL=https://marketing-platform-api.onrender.com/api/v1
VITE_AI_SERVICES_URL=https://marketing-ai-services.up.railway.app
VITE_SENTRY_DSN=https://xxx@sentry.io/123
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxx...
