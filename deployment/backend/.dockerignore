# ── Git ──────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Node ─────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build output ─────────────────────────────────────────────
dist/
build/

# ── Environment ──────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── IDE & Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Upload (don't copy uploaded files into Docker) ───────────
uploads/*
!uploads/.gitkeep

# ── Tests ────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Docker ───────────────────────────────────────────────────
.dockerignore
Dockerfile
Dockerfile.*
docker-compose*.yml
