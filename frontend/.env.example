# MARKETRON Frontend — Environment Variables
# Copy to .env.local and fill in values

# API URL (change to your Render/Railway backend URL in production)
NEXT_PUBLIC_API_URL=https://marketron-api.onrender.com/api/v1
NEXT_PUBLIC_APP_NAME=MARKETRON
NEXT_PUBLIC_APP_TAGLINE="MARKETING + AUTOMATION"

# Facebook App ID (for OAuth)
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Stripe (public key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Upload URL (same as API URL in production)
NEXT_PUBLIC_UPLOAD_URL=https://marketron-api.onrender.com/uploads
